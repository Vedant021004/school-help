{
  "functions": {
    "api/*.py": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path__=$1"
    },
    {
      "source": "/:match((?!api|assets|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
